<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="armpy_simple_arm">
  <xacro:property name="upper_len" value="0.22"/>
  <xacro:property name="forearm_len" value="0.18"/>

  <material name="dark_gray">
    <color rgba="0.18 0.20 0.22 1.0"/>
  </material>
  <material name="blue">
    <color rgba="0.10 0.35 0.85 1.0"/>
  </material>
  <material name="green">
    <color rgba="0.10 0.65 0.35 1.0"/>
  </material>
  <material name="orange">
    <color rgba="0.90 0.45 0.12 1.0"/>
  </material>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.08" length="0.03"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>
  </link>

  <joint name="base_yaw_joint" type="revolute">
    <parent link="base_link"/>
    <child link="base_column"/>
    <origin xyz="0 0 0.03" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="5" velocity="2"/>
  </joint>

  <link name="base_column">
    <visual>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.08"/>
      </geometry>
      <material name="blue"/>
    </visual>
  </link>

  <joint name="shoulder_joint" type="revolute">
    <parent link="base_column"/>
    <child link="upper_arm"/>
    <origin xyz="0 0 0.08" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.8" upper="1.8" effort="5" velocity="2"/>
  </joint>

  <link name="upper_arm">
    <visual>
      <origin xyz="${upper_len / 2} 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${upper_len} 0.035 0.035"/>
      </geometry>
      <material name="green"/>
    </visual>
  </link>

  <joint name="elbow_joint" type="revolute">
    <parent link="upper_arm"/>
    <child link="forearm"/>
    <origin xyz="${upper_len} 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.0" upper="2.7" effort="5" velocity="2"/>
  </joint>

  <link name="forearm">
    <visual>
      <origin xyz="${forearm_len / 2} 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${forearm_len} 0.03 0.03"/>
      </geometry>
      <material name="orange"/>
    </visual>
  </link>

  <joint name="wrist_joint" type="revolute">
    <parent link="forearm"/>
    <child link="wrist_link"/>
    <origin xyz="${forearm_len} 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.7" upper="2.7" effort="3" velocity="2"/>
  </joint>

  <link name="wrist_link">
    <visual>
      <origin xyz="0.025 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.025 0.025"/>
      </geometry>
      <material name="blue"/>
    </visual>
  </link>

  <joint name="gripper_joint" type="revolute">
    <parent link="wrist_link"/>
    <child link="gripper_link"/>
    <origin xyz="0.05 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.4" upper="0.4" effort="1" velocity="1"/>
  </joint>

  <link name="gripper_link">
    <visual>
      <origin xyz="0.035 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.07 0.06 0.018"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>
  </link>
</robot>
